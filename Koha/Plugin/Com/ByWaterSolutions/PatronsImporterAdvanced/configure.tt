[% USE Dumper %]
[% USE KohaDates %]
[% INCLUDE 'doc-head-open.inc' %]
 <title>Koha: Patron Importer plugin: Configuration</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<div id="breadcrumbs"><a href="/cgi-bin/koha/mainpage.pl">Home</a> &rsaquo; <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a> &rsaquo; Patron importer &rsaquo; Configuration</div>

<div id="doc3">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title">Utilities</h3>
      </div>
      <div class="panel-body">
        [% IF test_completed %]
            [% FOREACH r IN results %]
                [% IF r.error %]
                    <div class="alert alert-error" role="alert">
                        Test completed with errors for [% r.label | html %]: <pre>[% r.error | html %]</pre>
                    </div>
                [% ELSE %]
                    <div class="alert alert-success" role="alert">Test completed successfully for [% r.label | html %]!</div>
                [% END %]
            [% END %]
        [% ELSIF test_completed %]
        [% ELSE %]
            <form method="post">
              [% INCLUDE 'csrf-token.inc' %]
              <input type="hidden" name="op" value="cud-test"/>
              <input type="hidden" name="class" value="[% CLASS %]"/>
              <input type="hidden" name="method" value="[% METHOD %]"/>
              <input type="hidden" name="test" value="1" />
              <div class="form-group">
                  <label for="run-test-connection">Test connections</label>
                  <button type="submit" id="run-test-connection" class="btn btn-default">Test</button>
                  <span id="helpBlock" class="help-block">Test the SFTP and file transport connections using the data provided below.</span>
              </div>
            </form>
        [% END %]

        [% IF migration_completed %]
            [% IF migration.size %]
                <div class="alert alert-success" role="alert">
                    Migrated the SFTP settings to file transports and saved the configuration:
                    <ul>
                    [% FOREACH t IN migration %]
                        <li>
                            [% IF t.created %]Created[% ELSE %]Reused[% END %] file transport '[% t.transport.name | html %]' ( id [% t.transport.id | html %] ) for
                            [% FOREACH j IN t.jobs %]'[% j.name | html %]'[% IF j.directory_kept %] ( keeps its directory )[% END %][% UNLESS loop.last %], [% END %][% END %]
                        </li>
                    [% END %]
                    </ul>
                </div>
            [% ELSE %]
                <div class="alert alert-info" role="alert">No SFTP settings found to migrate.</div>
            [% END %]
        [% ELSIF migration_error %]
            <div class="alert alert-error" role="alert">
                Migration failed, the configuration was not changed: <pre>[% migration_error | html %]</pre>
            </div>
        [% END %]
        <form method="post">
          [% INCLUDE 'csrf-token.inc' %]
          <input type="hidden" name="op" value="cud-migrate"/>
          <input type="hidden" name="class" value="[% CLASS %]"/>
          <input type="hidden" name="method" value="[% METHOD %]"/>
          <input type="hidden" name="migrate" value="1" />
          <div class="form-group">
              <label for="run-migrate-sftp">Migrate SFTP settings to file transports</label>
              <button type="submit" id="run-migrate-sftp" class="btn btn-default">Migrate</button>
              <span class="help-block">Creates one Koha file transport per distinct SFTP connection in the configuration below, points the jobs at it and saves the configuration. Safe to run again. Requires Koha 25.11 or later.</span>
          </div>
        </form>
      </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading">
          <h3 class="panel-title">Settings</h3>
        </div>

        [% IF validation_errors %]
            <div class="alert alert-warning" role="alert">
                <h4>The configuration was not saved</h4>
                <ul>
                [% FOREACH e IN validation_errors %]
                    <li>[% IF e.line %]Line [% e.line | html %]: [% END %][% IF e.location %][% e.location | html %]: [% END %][% e.message | html %]</li>
                [% END %]
                </ul>
                <p>Fix the problems and save again, or tick "Save anyway" to store the configuration with these problems.</p>
                <details>
                    <summary>Columns the patron import accepts</summary>
                    [% valid_output_columns.join(', ') | html %]
                </details>
            </div>
        [% END %]

        <form method="post">
          [% INCLUDE 'csrf-token.inc' %]
          <input type="hidden" name="op" value="cud-save"/>
          <input type="hidden" name="class" value="[% CLASS %]"/>
          <input type="hidden" name="method" value="[% METHOD %]"/>
          <input type="hidden" name="save" value="1" />

          <fieldset>
            <legend>Configuration</legend>

            <div class="form-group">
              <textarea style="font-family:monospace;" class="form-control" rows="30" id="configuration" name="configuration">[% configuration | html %]</textarea>
            </div>
          </fieldset>


          <button type="submit" class="btn btn-default">Save</button>
          [% IF validation_errors %]
              <label class="checkbox-inline"><input type="checkbox" name="save_anyway" value="1" /> Save anyway</label>
          [% END %]
        </form>
    </div>

[% INCLUDE 'intranet-bottom.inc' %]
